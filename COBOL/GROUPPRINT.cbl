       ID DIVISION.
       PROGRAM-ID. GROUPPRINT.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT VSAM-FILE ASSIGN TO VSAMDSN
               ORGANIZATION IS INDEXED
               ACCESS MODE IS SEQUENTIAL
               RECORD KEY IS STDNAME.
       DATA DIVISION.
       FILE SECTION.
       FD VSAM-FILE.
       COPY STDREC.
       WORKING-STORAGE SECTION.
       01 EOF-FLAG PIC X VALUE 'N'.
       01 NAME-TABLE.
           05 NAME-ENTRY OCCURS 100 TIMES INDEXED BY IDX.
               10 NAME-VALUE PIC A(50).
               10 NAME-COUNT PIC 9(4) VALUE 0.
       01 TABLE-SIZE PIC 9(3) VALUE 0.
       PROCEDURE DIVISION.
       MAIN-PARA.
           OPEN INPUT VSAM-FILE.
           PERFORM READ-RECORD UNTIL EOF-FLAG = 'Y'.
           CLOSE VSAM-FILE.
           PERFORM PRINT-GROUPS.
           STOP RUN.
       READ-RECORD.
           READ VSAM-FILE
               AT END MOVE 'Y' TO EOF-FLAG
               NOT AT END PERFORM PROCESS-RECORD.
       PROCESS-RECORD.
           SET IDX TO 1.
           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > TABLE-SIZE OR NAME-VALUE(IDX) = STDNAME
               CONTINUE
           END-PERFORM.
           IF IDX > TABLE-SIZE
               ADD 1 TO TABLE-SIZE
               MOVE STDNAME TO NAME-VALUE(TABLE-SIZE)
               MOVE 1 TO NAME-COUNT(TABLE-SIZE)
           ELSE
               ADD 1 TO NAME-COUNT(IDX).
       PRINT-GROUPS.
           PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > TABLE-SIZE
               DISPLAY 'NAME: ' NAME-VALUE(IDX) ' COUNT: ' NAME-COUNT(IDX)
           END-PERFORM.